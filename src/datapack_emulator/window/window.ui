            <item>
             <widget class="QGroupBox" name="groupTests">
              <property name="title">
               <string>tests</string>
              </property>
              <layout class="QVBoxLayout" name="testsLayout">
               <item>
                <widget class="QLabel" name="labelTestsHelp">
                 <property name="text">
                  <string>Each test runs a command on the server console in a fresh world, e.g. "function hat:tick", or "execute as Player1 run trigger hat" for a command a player would type. Like in game, it runs in its tick after that tick's functions (tick 0 is the first tick, where #minecraft:load runs too). It passes when the command succeeds without a visible error and, if "expect" is set, that text appears in the game output.</string>
                 </property>
                 <property name="wordWrap">
                  <bool>true</bool>
                 </property>
                 <property name="styleSheet">
                  <string notr="true">color: #666;</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QTableWidget" name="tableTests">
                 <property name="contextMenuPolicy">
                  <enum>Qt::CustomContextMenu</enum>
                 </property>
                 <property name="minimumSize">
                  <size>
                   <width>0</width>
                   <height>260</height>
                  </size>
                 </property>
                 <property name="alternatingRowColors">
                  <bool>true</bool>
                 </property>
                 <property name="selectionBehavior">
                  <enum>QAbstractItemView::SelectRows</enum>
                 </property>
                 <property name="styleSheet">
                  <string notr="true">QTableWidget { font-family: monospace; font-size: 11px; }</string>
                 </property>
                 <column>
                  <property name="text">
                   <string>tick</string>
                  </property>
                  <property name="toolTip">
                   <string>the server tick the command runs in, after that tick's functions (0 = the first tick, where load runs too); untick to skip the test</string>
                  </property>
                 </column>
                 <column>
                  <property name="text">
                   <string>command</string>
                  </property>
                  <property name="toolTip">
                   <string>a command as typed on the server console; use execute as Player1 run … for a player</string>
                  </property>
                 </column>
                 <column>
                  <property name="text">
                   <string>expect output</string>
                  </property>
                  <property name="toolTip">
                   <string>text the game output of the command must contain (empty: no check)</string>
                  </property>
                 </column>
                 <column>
                  <property name="text">
                   <string>expect value</string>
                  </property>
                  <property name="toolTip">
                   <string>range the command's result must be in: 5, 1.., ..3 or 1..4 (empty: no check)</string>
                  </property>
                 </column>
                 <column>
                  <property name="text">
                   <string>result</string>
                  </property>
                  <property name="toolTip">
                   <string>why the test passed or failed; hover for its records, double-click to show them in the logs</string>
                  </property>
                 </column>
                </widget>
