  <action name="actionnew_project">
   <property name="text">
    <string>new project</string>
   </property>
   <property name="statusTip">
    <string>start a new project from the current settings and tests, under a name you choose</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+N</string>
   </property>
  </action>
  <action name="actionopen_project">
   <property name="text">
    <string>open project…</string>
   </property>
   <property name="statusTip">
    <string>open a .dpemu project (or an older .json one): settings, tests, notes and its datapack</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+Shift+O</string>
   </property>
  </action>
  <action name="actionsave_project">
   <property name="text">
    <string>save project</string>
   </property>
   <property name="statusTip">
    <string>save settings, tests, notes and a copy of the datapack into the project's .dpemu file</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+S</string>
   </property>
  </action>
  <action name="actionsave_project_as">
   <property name="text">
    <string>save project as…</string>
   </property>
   <property name="statusTip">
    <string>save the project under another name or folder</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+Shift+S</string>
   </property>
  </action>
  <action name="actionimport_datapack">
   <property name="text">
    <string>import datapack</string>
   </property>
   <property name="statusTip">
    <string>open a datapack folder (the one holding pack.mcmeta)</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+O</string>
   </property>
  </action>
  <action name="actionreload_datapack">
   <property name="text">
    <string>reload datapack</string>
   </property>
   <property name="statusTip">
    <string>read the datapack from disk again, keeping the version and project (after editing files)</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+R</string>
   </property>
  </action>
  <action name="actionload_vanilla">
   <property name="text">
    <string>load client jar…</string>
   </property>
   <property name="statusTip">
    <string>pick a Minecraft client jar by hand, to check ids and use the game's own messages</string>
   </property>
   <property name="toolTip">
    <string>read base-game registries and messages from a Minecraft client.jar</string>
   </property>
  </action>
  <action name="actiondownload_vanilla">
   <property name="text">
    <string>download client jar for this version</string>
   </property>
   <property name="statusTip">
    <string>download the client jar of the selected version from Mojang (checked with its SHA-1)</string>
   </property>
   <property name="toolTip">
    <string>fetch the jar from Mojang into .cache/vanilla</string>
   </property>
  </action>
  <action name="actionquit">
   <property name="text">
    <string>quit</string>
   </property>
   <property name="statusTip">
    <string>close the window (asks to save unsaved changes)</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+Q</string>
   </property>
  </action>
  <action name="actionopen_file_in_editor">
   <property name="text">
    <string>open in external editor</string>
   </property>
   <property name="statusTip">
    <string>open the explorer's selected file with the desktop's default application</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+Return</string>
   </property>
  </action>
  <action name="actionopen_folder_in_explorer">
   <property name="text">
    <string>open in external file manager</string>
   </property>
   <property name="statusTip">
    <string>show the explorer's selected file or folder in the desktop's file manager</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+Shift+Return</string>
   </property>
  </action>
  <action name="actionopen_in_source">
   <property name="text">
    <string>open in source view</string>
   </property>
   <property name="statusTip">
    <string>show the explorer's selected file in the source tab</string>
   </property>
  </action>
  <action name="actioncopy_path">
   <property name="text">
    <string>copy path</string>
   </property>
   <property name="statusTip">
    <string>copy the explorer's selected path to the clipboard</string>
   </property>
  </action>
  <action name="actionrun_profiler">
   <property name="text">
    <string>run profiler</string>
   </property>
   <property name="statusTip">
    <string>rebuild the profiler report from the current world, without running more ticks</string>
   </property>
  </action>
  <action name="actionrun_graphview">
   <property name="text">
    <string>run graphview</string>
   </property>
   <property name="statusTip">
    <string>rebuild the call graph of the version being emulated</string>
   </property>
  </action>
  <action name="actionrun_emulator">
   <property name="text">
    <string>run emulator</string>
   </property>
   <property name="statusTip">
    <string>run a fresh world for the configured ticks (no call graph rebuild)</string>
   </property>
   <property name="shortcut">
    <string>F6</string>
   </property>
  </action>
  <action name="actionstep_tick">
   <property name="text">
    <string>step one tick</string>
   </property>
   <property name="statusTip">
    <string>run one more tick in the current world (starts one if there is none)</string>
   </property>
   <property name="shortcut">
    <string>F7</string>
   </property>
  </action>
  <action name="actionstop">
   <property name="text">
    <string>stop</string>
   </property>
   <property name="statusTip">
    <string>stop the running emulation and refresh the profiler</string>
   </property>
   <property name="shortcut">
    <string>Shift+F5</string>
   </property>
  </action>
  <action name="actionrun_tests">
   <property name="text">
    <string>run tests</string>
   </property>
   <property name="statusTip">
    <string>run the environment tab's tests in a fresh world</string>
   </property>
   <property name="shortcut">
    <string>F8</string>
   </property>
  </action>
  <action name="actionenvironment">
   <property name="text">
    <string>environment tab</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+1</string>
   </property>
   <property name="statusTip">
    <string>world settings, run settings, tests and notes</string>
   </property>
  </action>
  <action name="actionrun_all">
   <property name="text">
    <string>run all</string>
   </property>
   <property name="statusTip">
    <string>run a fresh world for the configured ticks, then refresh the profiler and the call graph</string>
   </property>
   <property name="toolTip">
    <string>emulate, refresh the profiler and rebuild the call graph</string>
   </property>
   <property name="shortcut">
    <string>F5</string>
   </property>
  </action>
  <action name="actionopen_engine">
   <property name="text">
    <string>version engine…</string>
   </property>
   <property name="statusTip">
    <string>run the pack against many versions at once and compare the results</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+E</string>
   </property>
  </action>
  <action name="actionexport_dot">
   <property name="text">
    <string>export call graph (.dot)</string>
   </property>
   <property name="statusTip">
    <string>write the call graph as a Graphviz .dot file in generated/</string>
   </property>
  </action>
  <action name="actionexplorer">
   <property name="text">
    <string>explorer</string>
